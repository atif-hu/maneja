NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000

# OAuth (enable in Supabase Dashboard → Authentication → Providers)
# Google: Client ID + Client Secret from Google Cloud Console
# Facebook: App ID + App Secret from Meta Developer
# Apple: Services ID + Secret Key from Apple Developer
# Redirect URL for all: {SITE_URL}/auth/callback
# Example: http://localhost:3000/auth/callback
