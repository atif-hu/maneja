# Brand Manager — environment template
# Copy to .env and fill in values. Never commit real secrets.

# --- Supabase ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
INTERNAL_JOB_SECRET=change-me-internal-cron-secret
APP_ENV=development

# --- Google OAuth (for direct Google login) ---
# Get credentials from: https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs: http://localhost:8000/auth/google/callback (dev), https://yourdomain.com/auth/google/callback (prod)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Redis / queue ---
REDIS_URL=redis://127.0.0.1:6379

# --- Image generation ---
# provider: stub | openai | replicate
IMAGE_PROVIDER=stub
IMAGE_MODEL=stable-diffusion-3
OPENAI_API_KEY=
REPLICATE_API_KEY=

# --- Claude orchestration (for prompt generation) ---
CLAUDE_API_KEY=

# --- Next.js (also set in apps/web/.env.local) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000
